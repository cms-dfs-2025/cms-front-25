# Режим работы (development/production)
NODE_ENV=development

# Базовый URL API (совпадает с proxy в vue.config.js)
VUE_APP_API_BASE_URL=/api

# Порт для dev-сервера (должен совпадать с docker-compose)
VUE_APP_DEV_SERVER_PORT=8080

# Дополнительные переменные (пример)
VUE_APP_VERSION=1.0.0
VUE_APP_NAME=CMS-Frontend